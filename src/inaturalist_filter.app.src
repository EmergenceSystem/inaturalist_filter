{application, inaturalist_filter, [
    {description, "em_filter example for iNaturalist API"},
    {vsn, "0.2.0"},
    {registered, [inaturalist_filter_sup, inaturalist_filter_server]},
    {mod, {inaturalist_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        inaturalist_filter_sup,
        inaturalist_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/inaturalist_filter"}]}
]}.
